{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.elf_warrior.movement": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walk": "query.modified_move_speed > 0.1"
            },
            {
              "attack": "query.attack_time > 0"
            },
            {
              "hurt": "query.hurt_time > 0"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "attack": "query.attack_time > 0"
            },
            {
              "hurt": "query.hurt_time > 0"
            },
            {
              "default": "query.modified_move_speed <= 0.1"
            }
          ],
          "blend_transition": 0.2
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "hurt": "query.hurt_time > 0"
            },
            {
              "default": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.15
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.1
        }
      }
    },
    "controller.animation.elf_warrior.death": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "dying": "query.death_ticks > 0"
            }
          ]
        },
        "dying": {
          "animations": [
            "death"
          ],
          "transitions": []
        }
      }
    },
