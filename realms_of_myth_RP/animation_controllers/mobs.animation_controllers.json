    "controller.animation.dragon_whelp.movement": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "fly": "query.is_in_water_or_rain || !query.is_on_ground"
            },
            {
              "walk": "query.modified_move_speed > 0.1"
            },
            {
              "attack": "query.attack_time > 0"
            },
            {
              "hurt": "query.hurt_time > 0"
            }
          ]
        },
        "fly": {
          "animations": [
            "fly"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "attack": "query.attack_time > 0"
            },
            {
              "walk": "query.is_on_ground && query.modified_move_speed > 0.1"
            },
            {
              "default": "query.is_on_ground"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "fly": "!query.is_on_ground"
            },
            {
              "attack": "query.attack_time > 0"
            },
            {
              "hurt": "query.hurt_time > 0"
            },
            {
              "default": "query.modified_move_speed <= 0.1"
            }
          ]
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "hurt": "query.hurt_time > 0"
            },
            {
              "fly": "!query.is_on_ground"
            },
            {
              "walk": "query.modified_move_speed > 0.1 && query.all_animations_finished"
            },
            {
              "default": "query.all_animations_finished"
            }
          ]
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.dragon_fire.phase": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [],
          "transitions": [
            {
              "roaring": "variable.phase_roar > 0"
            },
            {
              "tail_swipe": "variable.phase_tail > 0"
            }
          ]
        },
        "roaring": {
